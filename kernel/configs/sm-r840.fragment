# SM-R840 (Galaxy Watch3, Exynos 9110) – Konfigurationsfragment auf Basis von erd9110_defconfig (Googles Wear-Zweig, 4.19.279).
# NUR Einstellungen, die wir bewusst setzen. Alles, wofür im Baum kein Treiber liegt (WLAN bcmdhd, Bluetooth, GPS, Sensorhub, Haptik),
# bleibt unverändert und ist in docs/device-support-matrix.md als "nicht vorhanden" geführt.
CONFIG_LOCALVERSION="-openwatch-r840"
# 1 GB RAM: komprimierter Swap im RAM, kleine CMA-Reserve
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CMA_SIZE_MBYTES=16
# Start: initramfs als Wurzel, devtmpfs/tmpfs für den Userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
# Eingabe + Anzeige für X11 (Framebuffer + evdev; Touch-Treiber ZTM620 ist in der Basis aktiv)
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ZXT_ZTM620=y
CONFIG_FB=y
# USB-Debugging über Gadget: serielle Konsole und Netzwerk (ACM/ECM), sobald ein Gerät bootet
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
# Storage: Samsung-eMMC über DesignWare-MMC, Dateisysteme für Systempartition
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
# Die Basis-defconfig lässt EXYNOS_CPUPM aus, MMC/USB/PWM/Display/cpuidle rufen aber deren Funktionen auf (Linkfehler im ersten Build)
CONFIG_EXYNOS_CPUPM=y
# Weniger Ballast fürs erste Bauen und für den knappen RAM
# CONFIG_DEBUG_INFO is not set
# CONFIG_MODULE_SIG is not set
# Samsungs proprietärer Hypervisor "uH"/RKP (init/_uh.S bindet die fehlende Binärdatei init/uh.elf ein,
# die nicht im GPL-Quellpaket enthalten ist). UH_RKP "select"-t UH, deshalb müssen alle vier Optionen aus.
# Nur relevant für echte Hardware/Signierung – fürs reine Kompilieren aus; keine funktionale Einbuße
# für unsere Zwecke (kein Flash, kein Boot).
# CONFIG_UH is not set
# CONFIG_UH_DEBUG is not set
# CONFIG_UH_RKP is not set
# CONFIG_UH_RKP_6G is not set
# CONFIG_UH_INFORM is not set
# CONFIG_NOBLESSE_LARGE schaltet drivers/sensors/lps22hb_noblesse/ (Barometer) ein, das sensors_register()
# aus sensors_core.c braucht; die Basis-defconfig lässt SENSORS_CORE aber aus (Linkfehler).
CONFIG_SENSORS_CORE=y
# Das übergeordnete Board-Flag: ohne CONFIG_NOBLESSE=y (nur NOBLESSE_LARGE war gesetzt) greift in
# arch/arm64/boot/dts/exynos/Makefile der generische "sonst"-Zweig und baut die kaputten
# Referenzboards smdk9110/maestro9110 statt unserer exynos9110-tizen_noblesse_large_bt-*.dtb.
CONFIG_NOBLESSE=y
